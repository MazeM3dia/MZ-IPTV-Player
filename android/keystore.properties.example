# Copy to keystore.properties (git-ignored) to sign release builds with your key.
# Make a key once with:
#   keytool -genkeypair -keystore my-release.jks -storetype PKCS12 -alias mz-iptv #           -keyalg RSA -keysize 4096 -validity 10000
# Keep the .jks outside the repository and back it up: every future update must be
# signed with the same key, or it won't install over the existing app.
storeFile=C:/path/to/my-release.jks
storePassword=change-me
keyAlias=mz-iptv
keyPassword=change-me
